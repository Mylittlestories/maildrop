{
  "name": "maildrop",
  "version": "1.0.0",
  "description": "Send oversized files as one link in a plain email. Static page, no server, no account, no build step.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "mock": "node tools/mock-host.mjs",
    "test": "node tests/unit.test.js && node tests/integration.test.js && node tests/browser.test.js && node tests/page.test.js",
    "test:unit": "node tests/unit.test.js",
    "test:integration": "node tests/integration.test.js",
    "test:browser": "node tests/browser.test.js",
    "test:page": "node tests/page.test.js",
    "live": "node tools/live-check.mjs"
  },
  "devDependencies": {
    "jsdom": "*"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "file-transfer",
    "wetransfer",
    "email",
    "large-files",
    "static",
    "github-pages",
    "webcrypto"
  ],
  "dependencies": {}
}
